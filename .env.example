# =============================================================================
# Hisab Kitab — environment configuration (TEMPLATE — no real values here)
# =============================================================================
#
# 1) FLUTTER CLIENT  →  copy to app/.env  (git-ignored)
#    Used at build time:  flutter build web --dart-define-from-file=.env
#    ONLY public values belong here. The publishable key is safe in a client
#    because every table is protected by Row Level Security.
#    In GitHub Actions these come from repository *Variables* (not Secrets).

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# development | staging | production
APP_ENV=development

# -----------------------------------------------------------------------------
# 2) SERVER-SIDE ONLY — never put these in app/.env or any client build
# -----------------------------------------------------------------------------
# Supabase provides these to Edge Functions automatically; you never set them:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY
#
# Optional Edge Function secret (supabase secrets set ALLOWED_ORIGINS=...):
#   ALLOWED_ORIGINS=https://<github-user>.github.io,http://localhost:8080
#
# Shopify / PostEx / BlueEx / M&P / Tranzo / XPS credentials are NOT env vars.
# Enter them in the app: Settings → Integrations. They are tested server-side
# and stored encrypted in Supabase Vault, and are never shown again.
#
# For Supabase CLI deploys from your machine (not CI):
#   SUPABASE_ACCESS_TOKEN=<personal access token>   # supabase.com/dashboard/account/tokens
#   SUPABASE_PROJECT_REF=<project-ref>
